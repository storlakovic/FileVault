ENVIRONMENT=development
JWT_SECRET_KEY=replace-with-secure-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_ORIGIN=http://localhost:3000
MAX_FILE_SIZE_BYTES=52428800
POSTGRES_USER=filevault
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=filevault
DATABASE_URL=postgresql+psycopg://filevault:replace-with-secure-password@db:5432/filevault